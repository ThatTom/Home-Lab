# Managed by Ansible (roles/rustic)
[Unit]
Description=Rustic prune of the shared B2 repository
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Nice=10
ExecStartPre=/usr/local/sbin/rustic-metrics start prune
ExecStart=/usr/local/bin/rustic prune
# Records success or failure for Prometheus, runs whatever the result
ExecStopPost=/usr/local/sbin/rustic-metrics stop prune
