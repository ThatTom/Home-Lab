# Managed by Ansible (roles/keepalived)
global_defs {
    router_id {{ inventory_hostname }}
    script_user keepalived_script
    enable_script_security
}

# Gives up the VIP when Traefik on this node stops answering
vrrp_script chk_traefik {
    script "/usr/bin/curl -fsS -o /dev/null -m 2 {{ keepalived_check_url }}"
    interval 2
    timeout 3
    fall 2
    rise 2
}

vrrp_instance traefik {
    state BACKUP
    interface {{ keepalived_interface }}
    virtual_router_id {{ keepalived_router_id }}
    priority {{ keepalived_priority }}
    advert_int 1
{% if keepalived_nopreempt %}
    nopreempt
{% endif %}

    # Unicast to the known peers only, so no shared password is needed
    unicast_src_ip {{ ansible_host }}
    unicast_peer {
{% for peer in keepalived_peers %}
        {{ hostvars[peer].ansible_host }}
{% endfor %}
    }

    virtual_ipaddress {
        {{ keepalived_vip }}/{{ keepalived_vip_prefix }} dev {{ keepalived_interface }}
    }

    track_script {
        chk_traefik
    }
}
