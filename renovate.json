{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["docker-compose"],
  "timezone": "Europe/London",
  "docker-compose": {
    "managerFilePatterns": ["/^docker-compose/.+\\.ya?ml$/"]
  },

  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",

  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "labels": ["renovate"],

  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/**"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["renovate", "major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["ghcr.io/immich-app/**", "vaultwarden/server"],
      "labels": ["renovate", "careful"]
    },
    {
      "description": "A Postgres major version can't read the previous one's data, upgrading needs a dump and restore",
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}